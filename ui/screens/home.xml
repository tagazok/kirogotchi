<screen>
	<styles>
		<!-- Base -->
		<style name="st_root_bg" bg_color="0x050507" bg_opa="255" border_width="0" pad_all="0" />

		<style
			name="st_panel"
			bg_color="0x0D0D12"
			bg_opa="245"
			radius="14"
			border_width="1"
			border_color="0x24202E"
			pad_all="0"
		/>

		<style
			name="st_chip"
			bg_color="0x12111A"
			bg_opa="255"
			radius="14"
			border_width="1"
			border_color="0x272036"
			pad_all="0"
		/>

		<style
			name="st_nav"
			bg_color="0x101017"
			bg_opa="255"
			radius="18"
			border_width="1"
			border_color="0x22202A"
			pad_all="0"
		/>

		<style
			name="st_nav_active"
			bg_color="0x24143D"
			bg_opa="255"
			radius="13"
			border_width="1"
			border_color="0x7A36FF"
			pad_all="0"
		/>

		<!-- Text -->
		<style name="st_title" text_color="0x9B5CFF" />

		<style name="st_text" text_color="0xF8F7FF" />

		<style name="st_muted" text_color="0x9B96A8" />

		<style name="st_purple_text" text_color="0x9B5CFF" />

		<style name="st_cyan_text" text_color="0x58D6FF" />

		<!-- Bars -->
		<style name="st_bar_empty" bg_color="0x2A2632" bg_opa="255" radius="3" border_width="0" />

		<style name="st_bar_purple" bg_color="0x8B4DFF" bg_opa="255" radius="3" border_width="0" />

		<style name="st_bar_yellow" bg_color="0xFFD935" bg_opa="255" radius="3" border_width="0" />

		<style name="st_bar_blue" bg_color="0x3BA7FF" bg_opa="255" radius="3" border_width="0" />

		<style name="st_bar_pink" bg_color="0xFF5CB8" bg_opa="255" radius="3" border_width="0" />

		<!-- Dots / icons -->
		<style name="st_dot_purple" bg_color="0x9B5CFF" bg_opa="255" radius="8" border_width="0" />

		<style name="st_dot_yellow" bg_color="0xFFD935" bg_opa="255" radius="8" border_width="0" />

		<style name="st_dot_blue" bg_color="0x3BA7FF" bg_opa="255" radius="8" border_width="0" />

		<style name="st_dot_pink" bg_color="0xFF5CB8" bg_opa="255" radius="8" border_width="0" />

		<style name="st_dot_green" bg_color="0x45E68A" bg_opa="255" radius="8" border_width="0" />

		<!-- Mascot -->
		<style
			name="st_ghost_body"
			bg_color="0xFFFFFF"
			bg_opa="255"
			radius="28"
			border_width="1"
			border_color="0xF1E9FF"
			pad_all="0"
		/>

		<style name="st_ghost_eye" bg_color="0x050507" bg_opa="255" radius="8" border_width="0" />

		<style name="st_ghost_blush" bg_color="0xC7A6FF" bg_opa="180" radius="4" border_width="0" />

		<style
			name="st_rug"
			bg_color="0x33205A"
			bg_opa="210"
			radius="32"
			border_width="1"
			border_color="0x5E34A8"
			pad_all="0"
		/>

		<style
			name="st_screen_card"
			bg_color="0x07080D"
			bg_opa="255"
			radius="4"
			border_width="1"
			border_color="0x44305F"
			pad_all="0"
		/>

		<style
			name="st_laptop"
			bg_color="0x151421"
			bg_opa="255"
			radius="4"
			border_width="1"
			border_color="0x4C3371"
			pad_all="0"
		/>
	</styles>

	<view>
		<!-- Full screen root -->
		<lv_obj x="0" y="0" width="240" height="280">
			<style name="st_root_bg" />

			<!-- Header -->
			<lv_obj x="16" y="16" width="12" height="16">
				<style name="st_ghost_body" />
			</lv_obj>

			<lv_obj x="19" y="21" width="3" height="5">
				<style name="st_ghost_eye" />
			</lv_obj>
			<lv_obj x="24" y="21" width="3" height="5">
				<style name="st_ghost_eye" />
			</lv_obj>

			<lv_label x="42" y="15" text="KIROGOTCHI">
				<style name="st_title" />
			</lv_label>

			<lv_label x="150" y="15" text="08:35">
				<style name="st_text" />
			</lv_label>

			<lv_label x="196" y="15" text="BT">
				<style name="st_purple_text" />
			</lv_label>

			<lv_obj x="216" y="17" width="14" height="8">
				<style name="st_bar_empty" />
			</lv_obj>
			<lv_obj x="218" y="19" width="9" height="4">
				<style name="st_bar_purple" />
			</lv_obj>

			<!-- Needs panel -->
			<lv_obj x="10" y="38" width="220" height="48">
				<style name="st_panel" />

				<!-- Hunger -->
				<lv_obj x="12" y="10" width="9" height="9">
					<style name="st_dot_purple" />
				</lv_obj>
				<lv_label x="27" y="7" text="HUNGER">
					<style name="st_text" />
				</lv_label>
				<lv_obj x="12" y="31" width="8" height="4">
					<style name="st_bar_purple" />
				</lv_obj>
				<lv_obj x="24" y="31" width="8" height="4">
					<style name="st_bar_purple" />
				</lv_obj>
				<lv_obj x="36" y="31" width="8" height="4">
					<style name="st_bar_purple" />
				</lv_obj>
				<lv_obj x="48" y="31" width="8" height="4">
					<style name="st_bar_empty" />
				</lv_obj>

				<!-- Energy -->
				<lv_obj x="66" y="10" width="9" height="9">
					<style name="st_dot_yellow" />
				</lv_obj>
				<lv_label x="81" y="7" text="ENERGY">
					<style name="st_text" />
				</lv_label>
				<lv_obj x="66" y="31" width="8" height="4">
					<style name="st_bar_yellow" />
				</lv_obj>
				<lv_obj x="78" y="31" width="8" height="4">
					<style name="st_bar_yellow" />
				</lv_obj>
				<lv_obj x="90" y="31" width="8" height="4">
					<style name="st_bar_yellow" />
				</lv_obj>
				<lv_obj x="102" y="31" width="8" height="4">
					<style name="st_bar_empty" />
				</lv_obj>

				<!-- Focus -->
				<lv_obj x="120" y="10" width="9" height="9">
					<style name="st_dot_blue" />
				</lv_obj>
				<lv_label x="135" y="7" text="FOCUS">
					<style name="st_text" />
				</lv_label>
				<lv_obj x="120" y="31" width="8" height="4">
					<style name="st_bar_blue" />
				</lv_obj>
				<lv_obj x="132" y="31" width="8" height="4">
					<style name="st_bar_blue" />
				</lv_obj>
				<lv_obj x="144" y="31" width="8" height="4">
					<style name="st_bar_blue" />
				</lv_obj>
				<lv_obj x="156" y="31" width="8" height="4">
					<style name="st_bar_empty" />
				</lv_obj>

				<!-- Social -->
				<lv_obj x="174" y="10" width="9" height="9">
					<style name="st_dot_pink" />
				</lv_obj>
				<lv_label x="189" y="7" text="SOC">
					<style name="st_text" />
				</lv_label>
				<lv_obj x="174" y="31" width="8" height="4">
					<style name="st_bar_pink" />
				</lv_obj>
				<lv_obj x="186" y="31" width="8" height="4">
					<style name="st_bar_pink" />
				</lv_obj>
				<lv_obj x="198" y="31" width="8" height="4">
					<style name="st_bar_pink" />
				</lv_obj>
				<lv_obj x="210" y="31" width="8" height="4">
					<style name="st_bar_empty" />
				</lv_obj>
			</lv_obj>

			<!-- Nearby matches chip -->
			<lv_obj x="14" y="94" width="144" height="30">
				<style name="st_chip" />

				<lv_obj x="12" y="8" width="14" height="14">
					<style name="st_dot_purple" />
				</lv_obj>

				<lv_label x="36" y="7" text="6">
					<style name="st_purple_text" />
				</lv_label>

				<lv_label x="52" y="7" text="matches nearby">
					<style name="st_text" />
				</lv_label>

				<lv_label x="128" y="7" text="&gt;">
					<style name="st_muted" />
				</lv_label>
			</lv_obj>

			<!-- Left code card -->
			<lv_obj x="14" y="134" width="70" height="70">
				<style name="st_screen_card" />

				<lv_label x="8" y="6" text="def kiro():">
					<style name="st_purple_text" />
				</lv_label>
				<lv_label x="14" y="20" text="coffee()">
					<style name="st_cyan_text" />
				</lv_label>
				<lv_label x="14" y="34" text="code()">
					<style name="st_cyan_text" />
				</lv_label>
				<lv_label x="14" y="48" text="ship()">
					<style name="st_cyan_text" />
				</lv_label>
				<lv_label x="8" y="60" text="&gt;_">
					<style name="st_muted" />
				</lv_label>
			</lv_obj>

			<!-- Small cube friend -->
			<lv_obj x="42" y="205" width="28" height="22">
				<style name="st_panel" />
				<lv_obj x="8" y="7" width="3" height="6">
					<style name="st_bar_purple" />
				</lv_obj>
				<lv_obj x="17" y="7" width="3" height="6">
					<style name="st_bar_purple" />
				</lv_obj>
			</lv_obj>

			<!-- Simple plant -->
			<lv_obj x="19" y="211" width="12" height="14">
				<style name="st_dot_green" />
			</lv_obj>
			<lv_obj x="16" y="224" width="18" height="8">
				<style name="st_panel" />
			</lv_obj>

			<!-- Purple rug -->
			<lv_obj x="72" y="187" width="86" height="30">
				<style name="st_rug" />
			</lv_obj>

			<!-- Kiro ghost mascot, made only from LVGL objects -->
			<lv_obj x="90" y="130" width="62" height="64">
				<style name="st_ghost_body" />

				<lv_obj x="19" y="20" width="8" height="18">
					<style name="st_ghost_eye" />
				</lv_obj>
				<lv_obj x="37" y="20" width="8" height="18">
					<style name="st_ghost_eye" />
				</lv_obj>

				<lv_obj x="13" y="39" width="7" height="4">
					<style name="st_ghost_blush" />
				</lv_obj>
				<lv_obj x="44" y="39" width="7" height="4">
					<style name="st_ghost_blush" />
				</lv_obj>

				<lv_obj x="6" y="49" width="15" height="14">
					<style name="st_ghost_body" />
				</lv_obj>
				<lv_obj x="24" y="50" width="15" height="13">
					<style name="st_ghost_body" />
				</lv_obj>
				<lv_obj x="42" y="49" width="15" height="14">
					<style name="st_ghost_body" />
				</lv_obj>
			</lv_obj>

			<!-- Code symbol -->
			<lv_label x="176" y="125" text="&lt;/&gt;">
				<style name="st_title" />
			</lv_label>

			<!-- Laptop -->
			<lv_obj x="158" y="178" width="58" height="34">
				<style name="st_laptop" />

				<lv_obj x="27" y="13" width="8" height="10">
					<style name="st_ghost_body" />
				</lv_obj>
			</lv_obj>

			<!-- Mug -->
			<lv_obj x="207" y="194" width="20" height="22">
				<style name="st_panel" />
			</lv_obj>
			<lv_label x="209" y="199" text="kiro">
				<style name="st_purple_text" />
			</lv_label>

			<!-- Bottom navigation -->
			<lv_obj x="12" y="228" width="216" height="42">
				<style name="st_nav" />

				<!-- Active home tab -->
				<lv_obj x="7" y="5" width="43" height="32">
					<style name="st_nav_active" />
					<lv_label x="14" y="1" text="H">
						<style name="st_purple_text" />
					</lv_label>
					<lv_label x="8" y="18" text="HOME">
						<style name="st_purple_text" />
					</lv_label>
				</lv_obj>

				<lv_label x="68" y="7" text="F">
					<style name="st_muted" />
				</lv_label>
				<lv_label x="60" y="25" text="FEED">
					<style name="st_muted" />
				</lv_label>

				<lv_label x="119" y="7" text="S">
					<style name="st_muted" />
				</lv_label>
				<lv_label x="106" y="25" text="SOCIAL">
					<style name="st_muted" />
				</lv_label>

				<lv_label x="177" y="7" text="A">
					<style name="st_muted" />
				</lv_label>
				<lv_label x="156" y="25" text="ANALYTICS">
					<style name="st_muted" />
				</lv_label>
			</lv_obj>
		</lv_obj>
	</view>
</screen>
